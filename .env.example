# Gemini API Key for Constrained Evidence-Grounded AI Debate System
# Get your API key from Google AI Studio: https://aistudio.google.com/
# (Optional: If omitted, engine gracefully falls back to deterministic debate generator)
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime LLM Model selection (defaults to gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite
LLM_MODEL=gemini-3.5-flash-lite

# SEC EDGAR User-Agent (format: Sample Company Name AdminContact@domain.com)
SEC_USER_AGENT="Finvestigate Research contact@finvestigate.dev"

# Database Persistence Configuration
# Local default: Leave unset to use zero-setup local SQLite (data/finvestigate.db)
# Production: Configure Turso/libSQL database connection
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# TURSO_STRICT=false

# Server Configuration
# PORT=3001
# NODE_ENV=development
# ALLOWED_ORIGINS="http://localhost:5173, http://localhost:3000"
# LOG_LEVEL=info

# Secret token authorizing mutating attack endpoints (required in production, optional in dev)
# API_SECRET_KEY=
