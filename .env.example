# ==============================================================================
# LLM Provider Configuration (OpenAI-Compatible / Gemini)
# ==============================================================================

# Option A: OpenAI-Compatible
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://your_openai_base_url/v1
LLM_MODEL=auto:fast

# Option B: Direct Google Gemini API Key
# (Alternative fallback if OPENAI_API_KEY is omitted)
GEMINI_API_KEY=

# SEC EDGAR User-Agent (format: Sample Company Name AdminContact@domain.com)
SEC_USER_AGENT="Finvestigate Research contact@finvestigate.dev"

# Database Persistence Configuration
# Local default: Leave unset to use zero-setup local SQLite (data/finvestigate.db)
# Production: Configure Turso/libSQL database connection
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# TURSO_STRICT=false

# Server Configuration
# PORT=3001
# NODE_ENV=development
# ALLOWED_ORIGINS="http://localhost:5173, http://localhost:3000"
# LOG_LEVEL=info